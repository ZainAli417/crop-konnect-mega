APP_NAME=CropConnect Sensor Backend
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
# Replace YOUR_SUPABASE_PASSWORD with the database password from Supabase.
DATABASE_URL=postgresql://postgres.oadsmdarmoxgauoqyhmd:Ifandif123$$@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
INGEST_API_KEY=change-this-before-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_HISTORY_LIMIT=1000
SERIAL_READER_ENABLED=true
SERIAL_POLL_INTERVAL_SECONDS=5
SERIAL_STARTUP_DELAY_SECONDS=10
SENSOR_INTER_READ_DELAY_MS=800
SENSOR_READ_ORDER=soil,wind_speed,wind_direction,rain,uv
SOLAR_READ_RETRIES=3
SERIAL_CONSOLE_OUTPUT_ENABLED=true
DEVICE_ID=RPAWTEX
STATION_NAME=Field Station 1
WEATHER_FORECAST_ENABLED=true
WEATHER_FORECAST_PROVIDER=open-meteo
WEATHER_FORECAST_HOURS=24
WEATHER_FORECAST_CACHE_MINUTES=30
WEATHER_FORECAST_TIMEZONE=UTC

WIND_SPEED_PORT=/dev/serial/by-path/platform-3f980000.usb-usb-0:1.4.3:1.0-port0
WIND_DIRECTION_PORT=/dev/serial/by-path/platform-3f980000.usb-usb-0:1.4.4.2:1.0-port0
RAIN_PORT=/dev/serial/by-path/platform-3f980000.usb-usb-0:1.4.4.3.4:1.0-port0




SOIL_PORT=/dev/serial/by-path/platform-3f980000.usb-usb-0:1.4.1:1.0-port0
SOLAR_PORT=/dev/serial/by-path/platform-3f980000.usb-usb-0:1.4.4.3:1.0-port0

