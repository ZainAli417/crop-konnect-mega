APP_NAME=CropConnect Sensor Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./cropconnect.db
INGEST_API_KEY=change-this-before-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_HISTORY_LIMIT=1000
SERIAL_READER_ENABLED=true
SERIAL_POLL_INTERVAL_SECONDS=5
# How often a sleeping poller re-checks for a settings change (cache lookup).
SETTINGS_REFRESH_INTERVAL_SECONDS=1
# How long station settings are reused before a cheap updated_at check hits the
# database. A settings PATCH invalidates the cache, so raising this is free.
SETTINGS_CACHE_TTL_SECONDS=15
DEVICE_ID=RPAWTEX
STATION_NAME=Field Station 1

# ── Sensor ports ────────────────────────────────────────────────────────────
# Prefer the stable names produced by `python -m app.tools.ports udev`.
# Raw /dev/ttyUSB* nodes are treated as LOW confidence and, with
# SENSOR_STRICT_IDENTITY=true, are not read at all — see docs/SENSOR_PORTS.md.
WIND_SPEED_PORT=/dev/rs485-wind-speed
WIND_DIRECTION_PORT=/dev/rs485-wind-direction
SOIL_PORT=/dev/rs485-soil
RAIN_PORT=/dev/rs485-rain
SOLAR_PORT=/dev/rs485-solar

# ── Sensor identity ─────────────────────────────────────────────────────────
# Refuse to read a port whose sensor identity is not confirmed. Publishing null
# beats publishing a UV value as rainfall. Set false only to debug.
SENSOR_STRICT_IDENTITY=true
# Probe adapters and match captured fingerprints, so identity survives the hub
# renaming /dev/ttyUSB*. Capture with: python -m app.tools.ports capture
SENSOR_FINGERPRINT_ENABLED=true
SENSOR_SIGNATURE_FILE=sensor_signatures.json
# Re-resolve identities periodically to pick up a hot-plug. 0 disables.
SENSOR_IDENTITY_RECHECK_SECONDS=300
# Hard deadline per sensor read; exceeding it skips that sensor for the cycle
# instead of stalling the API.
SENSOR_READ_TIMEOUT_SECONDS=6
# Consecutive failures before a sensor is put into backoff.
SENSOR_FAILURE_THRESHOLD=3
RELAY_CONTROL_ENABLED=false
RELAY_GPIO_MODE=BCM
RELAY_ACTIVE_LOW=true
RELAY_SETTLE_SECONDS=30
RELAY_WIND_PIN=17
RELAY_SOIL_PIN=27
RELAY_RAIN_PIN=22
RELAY_SOLAR_PIN=23
