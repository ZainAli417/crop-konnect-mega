# CropConnect RS-485 adapter pinning.
# Generated by: python -m app.tools.ports udev
#
# Each rule creates a stable /dev/rs485-<sensor> symlink. Point the
# matching *_PORT entry in .env at that symlink.

# wind_speed: anchored on hub socket — keep this adapter in that socket
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.4.2", SYMLINK+="rs485-wind-speed"

# wind_direction: anchored on hub socket — keep this adapter in that socket
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.3", SYMLINK+="rs485-wind-direction"

# soil: anchored on hub socket — keep this adapter in that socket
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.1", SYMLINK+="rs485-soil"

# rain: anchored on hub socket — keep this adapter in that socket
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.4.4", SYMLINK+="rs485-rain"

# solar: anchored on hub socket — keep this adapter in that socket
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-1.4.3.4", SYMLINK+="rs485-solar"

