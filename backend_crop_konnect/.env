APP_NAME=CropConnect Sensor Backend
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
# Replace YOUR_SUPABASE_PASSWORD with the database password from Supabase.
DATABASE_URL=postgresql://postgres.oadsmdarmoxgauoqyhmd:Ifandif123$$@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
INGEST_API_KEY=change-this-before-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_HISTORY_LIMIT=1000

# ── Station identity ────────────────────────────────────────────────────────
DEVICE_ID=RPAWTEX
STATION_NAME=Field Station 1

# ── Serial polling ──────────────────────────────────────────────────────────
SERIAL_READER_ENABLED=true
SERIAL_POLL_INTERVAL_SECONDS=5
SERIAL_STARTUP_DELAY_SECONDS=10
SENSOR_INTER_READ_DELAY_MS=800
SENSOR_READ_ORDER=soil,wind_speed,wind_direction,rain,uv
SOLAR_READ_RETRIES=3
SERIAL_CONSOLE_OUTPUT_ENABLED=true

# ── Settings cache (kills the per-second DB polling) ────────────────────────
# How often a sleeping poller re-checks for a settings change (cache lookup,
# not a query). Keep at 1 so app toggles still feel instant.
SETTINGS_REFRESH_INTERVAL_SECONDS=1
# How long settings are reused before ONE cheap updated_at query. A settings
# PATCH invalidates the cache immediately, so raising this costs nothing.
SETTINGS_CACHE_TTL_SECONDS=15

# ── Sensor ports ────────────────────────────────────────────────────────────
# These are the stable names created by:
#     python -m app.tools.ports udev -o 99-cropconnect-rs485.rules
#
# Do NOT go back to /dev/ttyUSB* — those are treated as LOW confidence and,
# with SENSOR_STRICT_IDENTITY=true below, will not be read at all.
#
# The old by-path values are kept commented out as a fallback. They are the
# reason rain/solar swapped: that hub chain re-enumerates and shifts the path.
#
SOIL_PORT=/dev/rs485-soil
# NOTE: these two look swapped on purpose - keep them as they are.
WIND_SPEED_PORT=/dev/rs485-wind-direction
WIND_DIRECTION_PORT=/dev/rs485-wind-speed
RAIN_PORT=/dev/rs485-rain
SOLAR_PORT=/dev/rs485-solar
# ── Sensor identity / anti-mislabel ─────────────────────────────────────────
# true = refuse to read a port whose sensor identity is not confirmed, and
# publish null instead. Keep true: a null gap beats storing a UV value as
# rainfall. Set false ONLY to debug wiring.
SENSOR_STRICT_IDENTITY=true
# Probe adapters and match fingerprints captured from your known-good sensors,
# so identity survives the hub renaming /dev/ttyUSB*.
#   python -m app.tools.ports capture --sensor rain
SENSOR_FINGERPRINT_ENABLED=true
SENSOR_SIGNATURE_FILE=sensor_signatures.json
# Re-resolve identities periodically so a hot-plug is picked up. 0 disables.
SENSOR_IDENTITY_RECHECK_SECONDS=300

# ── Failure isolation ───────────────────────────────────────────────────────
# Hard deadline per sensor read. On expiry that sensor is skipped for the cycle
# instead of stalling the event loop (and with it the whole API).
SENSOR_READ_TIMEOUT_SECONDS=10
# Consecutive failures before a sensor goes into 30s backoff.
SENSOR_FAILURE_THRESHOLD=3
# Attempts per sensor per cycle. Attempt 1 uses the cached handle; every later
# attempt reopens the port and waits SENSOR_RETRY_DELAY_MS first. This is what
# gives wind direction a second chance when wind speed (same relay) has just
# finished and the direction sensor is still settling.
# Keep attempts x (1s modbus timeout + retry delay) under
# SENSOR_READ_TIMEOUT_SECONDS.
SENSOR_READ_RETRIES=2
SENSOR_RETRY_DELAY_MS=400

# ── Relay control (TUNED — do not change) ───────────────────────────────────
RELAY_CONTROL_ENABLED=true
RELAY_GPIO_MODE=BCM
RELAY_ACTIVE_LOW=true
RELAY_SETTLE_SECONDS=15
# Floor applied on top of RELAY_SETTLE_SECONDS before the first read after a
# relay powers a sensor up. It is also the fastest a relay group can cycle, so
# a sensor scheduled below this is really read at this cadence. Was hard-coded
# at 30; lower it if you want sub-30s sensors to actually tick that fast.
RELAY_MIN_STABILIZE_SECONDS=30
RELAY_WIND_PIN=17
RELAY_SOIL_PIN=27
RELAY_RAIN_PIN=22
RELAY_SOLAR_PIN=23

# ── GPS (optional) ──────────────────────────────────────────────────────────
GPS_READER_ENABLED=true
GPS_PORT=/dev/ttyACM0
GPS_BAUD_RATE=9600
GPS_MIN_MOVE_METERS=5.0
GPS_REVERSE_GEOCODE_INTERVAL_SECONDS=15

# ── Weather forecast ────────────────────────────────────────────────────────
WEATHER_FORECAST_ENABLED=true
WEATHER_FORECAST_PROVIDER=open-meteo
WEATHER_FORECAST_HOURS=24
WEATHER_FORECAST_CACHE_MINUTES=30
WEATHER_FORECAST_TIMEZONE=UTC

# ── Local Excel logging ─────────────────────────────────────────────────────
EXCEL_LOGGING_ENABLED=true
EXCEL_LOG_DIR=reading_excel_logs
EXCEL_LOG_TIMEZONE=Asia/Karachi
